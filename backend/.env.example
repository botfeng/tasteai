# TasteAI 正式 Day 4 · 仅限单进程本地演示，不可直接公开部署。
# 复制本模板为 backend/.env，在编辑器中填写密钥；不要在聊天中提供。
# .env 已被 Git 忽略。本模板不得填写真实密钥。
# 在 backend 目录启动时显式传 --env-file .env；不传则只读进程环境。
# .venv/Scripts/python.exe -m uvicorn app.main:app --env-file .env --host 127.0.0.1 --port 8000 --no-proxy-headers
LLM_MODE=openai_compatible
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# 配置不等于费用授权。保持 false，等待明确批准单次验收。
# 单次验收命令仅在本次进程中授权，绝不改写此文件。
# 常规真实服务需另行明确授权，之后才可改为 true。
LLM_ALLOW_PAID_CALLS=false
LLM_RESPONSE_FORMAT=json_object
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4000

# DeepSeek 使用 thinking.type=disabled；不自动重试、跳转、探测或回退 Mock。
# 0 禁止内容修复；1 最多修复一次且同样消耗调用限额。
LLM_MAX_REPAIRS=0
LLM_PER_IP_PER_MINUTE=6
LLM_DAILY_ATTEMPT_LIMIT=20
LLM_MAX_CONCURRENT=1
LLM_MAX_IP_ENTRIES=512

# 限额仅在单进程内存生效，UTC 每日重置，重启会清零，不是金额保证。
# 单次验收另有独占报告文件保护，失败也不自动再次调用。
# Mock 联调不要加载 .env，使用进程环境 LLM_MODE=mock。
# strictIngredients=true 禁止额外主要食材。
# assumeBasics=true 只假定水、食用油、盐、黑胡椒；false 则未选基础料也不可用。
# 结构及词汇校验不能保证烹饪语义、过敏原或食品安全；内容仍须人工复核。

# Day 4 菜品示意图搜索（Openverse 官方匿名 API，无需注册、无需 Key，默认启用）。
# 仅使用 CC0 / Public Domain Mark / CC BY 素材；展示作者、原始图片页与授权链接。
# 可选：将来若注册 Openverse OAuth 客户端，可在此填写令牌（Bearer）；留空即匿名。
# 密钥只填写到本文件；不要粘贴到聊天，不要提交 Git。
PHOTO_API_KEY=
# 上游超时秒数（1–30）。匿名限额实测为 20 次/分钟（突发）、200 次/天（持续）。
# 本地平滑限额：每小时（1–200）、每天（1–1000），均低于官方额度；内存计数，重启清零。
PHOTO_TIMEOUT_SECONDS=6
PHOTO_HOUR_LIMIT=60
PHOTO_DAY_LIMIT=180
# 可选 HTTP(S) 代理。中国大陆网络直连 api.openverse.org 可能超时（DNS 污染），
# 若本机已有系统代理可填写，例如 PHOTO_PROXY=http://127.0.0.1:11801；留空则直连。
PHOTO_PROXY=
# 图片仅热链接 Openverse 缩略图端点（合理尺寸），不下载、不再分发；搜索元数据缓存 12 小时。
# 匹配基于标题+标签的关键词综合评分，不是视觉识别；照片一律标注「菜品示意图」。
# 图片搜索失败只影响配图（保留占位图），绝不影响推荐与收藏。
